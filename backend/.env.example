DATABASE_URL=postgresql://user:password@host/cloudsnacks?sslmode=require

OTP_PRIMARY_CHANNEL=whatsapp
OTP_FALLBACK_CHANNEL=sms
OTP_ALLOW_DEV_FALLBACK=true

# WhatsApp OTP. Use either a provider webhook or official Meta Cloud API.
WHATSAPP_PROVIDER=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=cloud_snacks_otp
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_API_VERSION=v20.0
WHATSAPP_INCLUDE_BUTTON_CODE=true
WHATSAPP_BUTTON_SUB_TYPE=url

# SMS fallback. Use "dev" only for local testing. Use "fast2sms" or "webhook" for real OTP SMS.
SMS_PROVIDER=fast2sms

# Fast2SMS real OTP delivery. Keep the real key only in backend/.env, never in source control.
FAST2SMS_API_KEY=replace_with_your_fast2sms_api_key

KITCHEN_ORIGIN_LABEL=Vandanapuri Colony, Beeramguda, Hyderabad

# Alternative custom SMS gateway/webhook delivery.
# SMS_PROVIDER=webhook
# SMS_WEBHOOK_URL=https://your-sms-gateway.example/send
# SMS_WEBHOOK_TOKEN=replace_with_optional_bearer_token
